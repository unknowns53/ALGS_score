# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Liquipedia / external HTML fetches (transient data-checking artifacts)
algs_*.html
_ssg_*.html
*.wikitext

# Partial-region fit proposals (generated by fit_region_presets.py when
# --regions != canonical set; canonical proposal docs/region_refit_proposal.md
# is tracked, side-runs are not).
docs/region_refit_proposal__*.md

# Simulation outputs (ignore everything under out/ by default)
out/*
# Track article assets: rendered tables and the distribution plots
# embedded in docs/article_draft.md. Regenerated by
# tools/render_article_tables.py and tools/plot_equal_sweep.py and
# tools/inspect_pkf_kill_distribution.py.
!out/article_tables/
!out/plot_equal_sweep_*.png
!out/plot_tilt30_sweep_*.png
!out/plot_tilt30_base.png
!out/plot_pkf_per_placement_kills.png
